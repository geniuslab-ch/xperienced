---
import SupportForm from '../forms/SupportForm.astro';
import { fr } from '../../content/fr';
import { rich } from '../../lib/rich';
const t = fr.join;
const presets: Record<string, string | undefined> = {
  autres: 'form-individu:objectifs:emploi:benevolat',
};
---
<section id="rejoindre" class="section" aria-labelledby="join-title">
  <div class="wrap">
    <p class="kicker">{t.kicker}</p>
    <h2 id="join-title" class="title" set:html={rich(t.title)} />

    <ul class="pathways">
      {t.pathways.map((p, i) => (
        <li class="reveal">
          <a href={p.href} data-track={`rejoindre-${p.form}${p.preset ? '-' + p.preset : ''}`} data-preset={p.preset ? presets[p.preset] : undefined}>
            <span class="pw-n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <span class="pw-label">{p.label}</span>
            <span class="pw-arrow" aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ul>

    <div class="referral" data-share data-share-text={t.shareText} data-copied={t.copied}>
      <div>
        <h3>{t.referralTitle}</h3>
        <p>{t.referralText}</p>
      </div>
      <div class="share-actions">
        <button type="button" class="btn btn--lime" data-share-native hidden>{t.shareCta} <span class="arrow" aria-hidden="true">↗</span></button>
        <button type="button" class="btn btn--ghost" data-share-copy>Copier le lien</button>
        <ul class="share-links" aria-label={t.shareCta}>
          <li><a data-share-channel="whatsapp" href="https://wa.me/" target="_blank" rel="noopener">WhatsApp</a></li>
          <li><a data-share-channel="email" href="mailto:">E-mail</a></li>
          <li><a data-share-channel="linkedin" href="https://www.linkedin.com/" target="_blank" rel="noopener">LinkedIn</a></li>
          <li><a data-share-channel="facebook" href="https://www.facebook.com/" target="_blank" rel="noopener">Facebook</a></li>
        </ul>
        <p class="share-status" data-share-status role="status"></p>
      </div>
    </div>

    <div id="soutenir" class="support">
      <div class="support-intro">
        <h3>{fr.forms.soutienTitle}</h3>
        <p>{fr.forms.soutienLead}</p>
      </div>
      <SupportForm />
    </div>
  </div>
</section>
<style>
  .pathways { list-style: none; padding: 0; margin: clamp(2.5rem, 5vw, 4rem) 0 0; border-top: 2px solid var(--ink); }
  .pathways a { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 1.25rem; padding: 1.4rem 0.25rem; border-bottom: 2px solid var(--ink); text-decoration: none; transition: background-color 0.2s ease, padding 0.2s ease; }
  .pathways a:hover { background: var(--accent); padding-inline: 1rem; }
  .pw-n { font-weight: 800; color: var(--accent-ink); font-size: 0.95rem; }
  .pathways a:hover .pw-n { color: var(--ink); }
  .pw-label { font-size: var(--step-2); font-weight: 700; letter-spacing: -0.02em; line-height: 1.15; }
  .pw-arrow { font-size: var(--step-2); transition: transform 0.2s ease; }
  .pathways a:hover .pw-arrow { transform: translateX(6px); }

  .referral { margin-top: clamp(3rem, 6vw, 5rem); background: var(--ink); color: var(--ivory); border-radius: var(--radius-lg); padding: clamp(1.5rem, 4vw, 3rem); display: grid; gap: 2rem; }
  @media (min-width: 960px) { .referral { grid-template-columns: 1fr 1fr; align-items: center; gap: 4rem; } }
  .referral h3 { font-size: var(--step-3); margin-bottom: 1rem; }
  .referral p { color: #d9d6e3; font-size: var(--step-1); line-height: 1.5; }
  .referral :focus-visible { box-shadow: 0 0 0 3px var(--ink), 0 0 0 6px var(--lime); }
  .share-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; align-items: center; }
  .share-actions .btn--ghost { color: var(--ivory); border-color: var(--ivory); }
  .share-actions .btn--ghost:hover { background: var(--ivory); color: var(--ink); }
  .share-links { list-style: none; padding: 0; margin: 0.5rem 0 0; display: flex; flex-wrap: wrap; gap: 0.5rem 1.25rem; width: 100%; }
  .share-links a { color: var(--ivory); font-weight: 600; }
  .share-status { width: 100%; color: var(--lime) !important; font-size: var(--step--1) !important; min-height: 1.5em; }

  .support { margin-top: clamp(3rem, 6vw, 5rem); display: grid; gap: 2rem; background: var(--paper); border: 1px solid var(--line); border-radius: var(--radius-lg); padding: clamp(1.25rem, 4vw, 3rem); }
  @media (min-width: 1000px) { .support { grid-template-columns: 0.7fr 1.3fr; gap: 4rem; } }
  .support-intro h3 { font-size: var(--step-3); margin-bottom: 1rem; }
  .support-intro p { color: var(--ink-soft); }
</style>
