---
import { fr } from '../../content/fr';
import { rich } from '../../lib/rich';
const t = fr.how;
---
<section id="comment" class="section section--sand" aria-labelledby="how-title">
  <div class="wrap">
    <p class="kicker">{t.kicker}</p>
    <h2 id="how-title" class="title" set:html={rich(t.title)} />
    <ol class="steps">
      {t.steps.map((s, i) => (
        <li class="step reveal">
          <span class="step-n" aria-hidden="true">{i + 1}</span>
          <h3>{s.title}</h3>
          <p>{s.text}</p>
        </li>
      ))}
    </ol>
    <div class="honesty reveal">
      <span class="stamp" aria-hidden="true">Franchise</span>
      <p>{t.honesty}</p>
    </div>
  </div>
</section>
<style>
  .steps { list-style: none; margin: clamp(2.5rem, 5vw, 4rem) 0 0; padding: 0; display: grid; gap: 2rem; counter-reset: s; }
  @media (min-width: 860px) { .steps { grid-template-columns: repeat(3, 1fr); gap: 2.5rem; } }
  .step { border-top: 3px solid var(--ink); padding-top: 1.5rem; }
  .step-n { display: inline-grid; place-items: center; width: 3rem; height: 3rem; border-radius: 50%; background: var(--ink); color: var(--ivory); font-weight: 800; font-size: 1.25rem; margin-bottom: 1.25rem; }
  .step h3 { font-size: var(--step-2); margin-bottom: 0.75rem; }
  .step p { color: var(--ink-soft); }
  .honesty { margin-top: clamp(2.5rem, 5vw, 4rem); display: grid; gap: 1.25rem; align-items: center; background: var(--paper); border-radius: var(--radius-lg); padding: clamp(1.5rem, 3vw, 2.25rem); border: 2px solid var(--ink); }
  @media (min-width: 760px) { .honesty { grid-template-columns: auto 1fr; gap: 2rem; } }
  .honesty .stamp { color: var(--accent-ink); font-size: 1rem; justify-self: start; }
  .honesty p { font-size: var(--step-1); line-height: 1.5; }
</style>
