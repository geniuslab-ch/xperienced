---
import { fr } from '../../content/fr';
import { rich } from '../../lib/rich';
const t = fr.final;
---
<section class="section section--dark final" aria-labelledby="final-title">
  <div class="wrap">
    <h2 id="final-title" class="final-title" set:html={rich(t.title)} />
    <div class="final-row">
      <p class="lead">{t.text}</p>
      <a href="#inscription" class="btn btn--accent final-btn" data-track="final-premier-pas">{t.cta} <span class="arrow" aria-hidden="true">→</span></a>
    </div>
  </div>
</section>
<style>
  .final { overflow: hidden; }
  .final-title { font-size: var(--step-5); line-height: 0.95; letter-spacing: -0.045em; font-weight: 800; max-width: 15ch; }
  .final-title :global(em) { font-family: var(--font-serif); font-weight: 400; color: var(--accent); }
  .final-row { display: flex; flex-wrap: wrap; gap: 2rem; align-items: center; justify-content: space-between; margin-top: 3rem; }
  .final-btn { font-size: var(--step-1); min-height: 4rem; padding-inline: 2rem; }
</style>
