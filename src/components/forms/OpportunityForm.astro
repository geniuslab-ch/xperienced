---
import FormShell from './FormShell.astro';
import Field from './Field.astro';
import Choices from './Choices.astro';
import { TYPES_ORG, TYPES_OPPORTUNITE, STATUTS, SOURCES } from '../../lib/forms';

const id = 'form-opportunite';
---
<FormShell kind="opportunite" id={id}>
  <div class="form-grid form-grid--2">
    <Field formId={id} name="organisation" label="Entreprise ou organisation" required autocomplete="organization" maxlength={120} />
    <Field formId={id} name="type_org" type="select" label="Type d’organisation" required options={TYPES_ORG} />
    <Field formId={id} name="contact_nom" label="Personne de contact" required autocomplete="name" maxlength={100} />
    <Field formId={id} name="email" type="email" label="E-mail professionnel" required autocomplete="email" maxlength={120} />
    <Field formId={id} name="telephone" type="tel" label="Téléphone" autocomplete="tel" maxlength={30} />
    <Field formId={id} name="type_opportunite" type="select" label="Type d’opportunité" required options={TYPES_OPPORTUNITE} />
  </div>

  <Choices formId={id} name="statut" legend="L’opportunité est-elle rémunérée ?" type="radio" required options={STATUTS} hint="Nous présentons chaque opportunité telle qu’elle est." />

  <Field formId={id} name="description" type="textarea" label="Description du besoin" required maxlength={1500} rows={4}
    placeholder="Ex. Nous cherchons quelqu’un pour accompagner nos deux apprentis en menuiserie, une demi-journée par semaine." />
  <Field formId={id} name="competences" type="textarea" label="Compétences ou expérience recherchées" maxlength={600} rows={3} />

  <div class="form-grid form-grid--2">
    <Field formId={id} name="lieu" label="Lieu" required maxlength={120} placeholder="Ex. Lausanne, Nyon, Fribourg…" />
    <Field formId={id} name="engagement" label="Engagement attendu" maxlength={200} placeholder="Ex. 2 jours/semaine, 3 mois, ponctuel…" />
  </div>

  <label class="choice">
    <input type="checkbox" name="distance" value="oui" />
    <span>Possible en partie ou totalement à distance</span>
  </label>

  <div class="form-grid form-grid--2">
    <Field formId={id} name="infos" type="textarea" label="Informations complémentaires" maxlength={1000} rows={3} />
    <Field formId={id} name="source" type="select" label="Comment avez-vous connu Xperienced ?" options={SOURCES} emptyOption="—" />
  </div>
</FormShell>
