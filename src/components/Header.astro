---
import Logo from './Logo.astro';
import { fr } from '../content/fr';
---
<header class="site-header">
  <div class="wrap bar">
    <a href="/" class="brand" aria-label="Xperienced, accueil"><Logo /></a>
    <nav aria-label="Navigation principale" class="nav-desktop">
      <ul>
        {fr.nav.map((item) => <li><a href={`/${item.href}`}>{item.label}</a></li>)}
      </ul>
    </nav>
    <a href="/#inscription" class="btn btn--accent btn-sm nav-cta" data-track="nav-inscription">{fr.navCta}</a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="menu" data-menu-toggle>
      <span class="sr-only">Menu</span>
      <span class="burger" aria-hidden="true"></span>
    </button>
  </div>
  <div id="menu" class="menu-mobile" data-open="false">
    <nav aria-label="Navigation mobile">
      <ul>
        {fr.nav.map((item) => <li><a href={`/${item.href}`}>{item.label}</a></li>)}
      </ul>
      <a href="/#inscription" class="btn btn--accent" data-track="menu-inscription">{fr.navCta} <span class="arrow" aria-hidden="true">→</span></a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 50;
    background: color-mix(in srgb, var(--ivory) 88%, transparent);
    backdrop-filter: saturate(1.4) blur(12px);
    -webkit-backdrop-filter: saturate(1.4) blur(12px);
    border-bottom: 1px solid color-mix(in srgb, var(--ink) 10%, transparent);
  }
  .bar { display: flex; align-items: center; gap: 1rem; min-height: 4.5rem; }
  .brand { text-decoration: none; margin-right: auto; }
  .nav-desktop { display: none; }
  .nav-desktop ul, .menu-mobile ul { list-style: none; margin: 0; padding: 0; }
  .nav-desktop ul { display: flex; gap: 0.25rem; }
  .nav-desktop a { display: block; padding: 0.5rem 0.8rem; border-radius: 999px; text-decoration: none; font-weight: 550; font-size: 1rem; }
  .nav-desktop a:hover { background: var(--sand); }
  .btn-sm { min-height: 2.75rem; padding: 0.55rem 1.1rem; font-size: 1rem; }
  .nav-cta { display: none; }
  @media (min-width: 560px) { .nav-cta { display: inline-flex; } }
  .menu-toggle {
    width: 3rem; height: 3rem; border: 2px solid var(--ink); border-radius: 999px; background: transparent;
    display: grid; place-items: center; cursor: pointer; color: var(--ink);
  }
  .burger, .burger::before, .burger::after { display: block; width: 1.15rem; height: 2px; background: currentColor; border-radius: 2px; transition: transform 0.2s ease, opacity 0.2s ease; }
  .burger { position: relative; }
  .burger::before, .burger::after { content: ''; position: absolute; left: 0; }
  .burger::before { top: -6px; }
  .burger::after { top: 6px; }
  [aria-expanded='true'] .burger { background: transparent; }
  [aria-expanded='true'] .burger::before { transform: translateY(6px) rotate(45deg); }
  [aria-expanded='true'] .burger::after { transform: translateY(-6px) rotate(-45deg); }

  .menu-mobile { display: none; }
  .menu-mobile[data-open='true'] {
    display: block; position: fixed; inset: 4.5rem 0 0; background: var(--ivory); overflow-y: auto;
    padding: 1.5rem var(--gutter) 3rem;
  }
  .menu-mobile ul { display: grid; margin-bottom: 2rem; }
  .menu-mobile li a { display: block; padding: 1rem 0; font-size: var(--step-2); font-weight: 700; text-decoration: none; border-bottom: 1px solid var(--line); }
  .menu-mobile .btn { width: 100%; }

  @media (min-width: 960px) {
    .nav-desktop { display: block; }
    .menu-toggle, .menu-mobile, .menu-mobile[data-open='true'] { display: none; }
  }
</style>
