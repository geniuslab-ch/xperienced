---
import Page from '../layouts/Page.astro';
---
<Page title="Page introuvable · Xperienced" description="Cette page n’existe pas." noindex>
  <section class="section">
    <div class="wrap">
      <p class="kicker">Erreur 404</p>
      <h1 class="title">Cette page a peut-être pris sa retraite. <em>Pas vous.</em></h1>
      <p class="lead" style="margin-top:1.5rem">La page demandée n’existe pas ou plus.</p>
      <p style="margin-top:2rem"><a class="btn btn--accent" href="/">Retour à l’accueil <span class="arrow" aria-hidden="true">→</span></a></p>
    </div>
  </section>
</Page>
