---
/** Gabarit de l'image de partage (1200×630). Régénérer avec : npm run images (serveur lancé). */
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
---
<Base title="Image de partage · Xperienced" description="Gabarit d’image de partage." noindex>
  <div class="og">
    <div class="og-left">
      <Logo />
      <p class="og-title">L’expérience n’a pas de date de <em>péremption</em>.</p>
      <p class="og-sub">Emploi · missions · bénévolat · transmission — après 50 ans, en Suisse.</p>
    </div>
    <div class="og-right">
      <span class="og-stamp og-stamp--old">Expiré</span>
      <span class="og-stamp og-stamp--new">Expérimenté</span>
    </div>
  </div>
</Base>
<style>
  :global(body) { margin: 0; }
  :global(.skip-link) { display: none; }
  .og { width: 1200px; height: 630px; background: var(--ivory); display: grid; grid-template-columns: 1.5fr 1fr; padding: 64px; box-sizing: border-box; overflow: hidden; }
  .og-left { display: flex; flex-direction: column; justify-content: space-between; }
  .og-left :global(.logo) { font-size: 2.2rem; }
  .og-title { font-size: 76px; line-height: 0.95; font-weight: 800; letter-spacing: -0.045em; }
  .og-title em { font-family: var(--font-serif); font-weight: 400; color: var(--accent-ink); }
  .og-sub { font-size: 24px; color: var(--ink-soft); }
  .og-right { position: relative; background: var(--ink); border-radius: 24px; margin: -16px -16px -16px 24px; }
  .og-stamp { position: absolute; font-weight: 800; text-transform: uppercase; letter-spacing: 0.06em; border: 6px solid currentColor; border-radius: 10px; padding: 10px 18px 6px; line-height: 1; }
  .og-stamp--old { top: 150px; left: 40px; font-size: 56px; color: #8b8b95; transform: rotate(-10deg); text-decoration: line-through; text-decoration-color: var(--accent); text-decoration-thickness: 8px; }
  .og-stamp--new { top: 330px; left: 34px; font-size: 40px; color: var(--lime); transform: rotate(-6deg); }
</style>
