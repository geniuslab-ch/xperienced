# Copiez ce fichier en « .env » pour le développement local. Ne commitez jamais le vrai fichier .env.
# Sur Vercel : Project › Settings › Environment Variables (puis redéployer).

# Adresse publique du site (SEO, liens de partage, QR codes des affiches). Sans barre finale.
# Facultatif sur Vercel (l'adresse de production du projet est utilisée par défaut).
SITE_URL=https://xperienced.vercel.app

# --- Base de données Supabase (enregistre tous les formulaires et les scans QR) ---
# Clé SECRÈTE (sb_secret_… ou ancienne service_role) : serveur uniquement, ne jamais la publier.
SUPABASE_SECRET_KEY=
# Facultatif : par défaut le projet Xperienced
SUPABASE_URL=https://tdmlanvywfbzqjlzzqxu.supabase.co

# --- Notifications et autres canaux (facultatifs) ---
# 0) RECOMMANDÉ — Notification e-mail via la messagerie Infomaniak (Suisse)
SMTP_HOST=mail.infomaniak.com
SMTP_PORT=465
# Adresse e-mail Infomaniak qui envoie les notifications, et son mot de passe
SMTP_USER=
SMTP_PASS=
# Boîte(s) qui reçoivent les formulaires (séparées par des virgules)
NOTIFY_EMAIL_TO=

# ⚠️ Les deux canaux ci-dessous stockent les données hors de Suisse : si vous les activez,
# mettez à jour la politique de confidentialité (src/pages/confidentialite.astro).
# 1) Webhook (ex. Google Sheets via Apps Script, voir docs/google-sheets-webhook.gs, ou Make/n8n/Zapier)
FORM_WEBHOOK_URL=
# Secret partagé, vérifié par le destinataire (facultatif mais recommandé)
FORM_WEBHOOK_SECRET=

# 2) E-mail de notification via Resend (https://resend.com, offre gratuite)
RESEND_API_KEY=
# Expéditeur (Resend : domaine vérifié ; Infomaniak : par défaut SMTP_USER)
NOTIFY_EMAIL_FROM=Xperienced <formulaires@votre-domaine.ch>

# --- Mesure d'audience sans cookie (facultatif, lu au moment du build) ---
# Plausible : le domaine déclaré dans Plausible (ex. xperienced.ch)
PUBLIC_PLAUSIBLE_DOMAIN=
# PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/script.tagged-events.js
# Umami : identifiant du site (ex. Umami Cloud, offre gratuite)
PUBLIC_UMAMI_WEBSITE_ID=
# PUBLIC_UMAMI_SRC=https://cloud.umami.is/script.js
