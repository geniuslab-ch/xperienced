# Copiez ce fichier en « .env » pour le développement local. Ne commitez jamais le vrai fichier .env.
# Sur Render, ces valeurs se saisissent dans le tableau de bord (Environment).

# Adresse publique du site (SEO, liens de partage, QR codes des affiches). Sans barre finale.
SITE_URL=https://xperienced.onrender.com

# --- Réception des formulaires : configurez AU MOINS UN des deux canaux ---
# 1) Webhook (ex. Google Sheets via Apps Script, voir docs/google-sheets-webhook.gs, ou Make/n8n/Zapier)
FORM_WEBHOOK_URL=
# Secret partagé, vérifié par le destinataire (facultatif mais recommandé)
FORM_WEBHOOK_SECRET=

# 2) E-mail de notification via Resend (https://resend.com, offre gratuite)
RESEND_API_KEY=
# Une ou plusieurs adresses séparées par des virgules
NOTIFY_EMAIL_TO=
# Expéditeur sur un domaine vérifié dans Resend (sinon l'adresse de test Resend est utilisée)
NOTIFY_EMAIL_FROM=Xperienced <formulaires@votre-domaine.ch>

# --- Mesure d'audience sans cookie (facultatif, lu au moment du build) ---
# Plausible : le domaine déclaré dans Plausible (ex. xperienced.ch)
PUBLIC_PLAUSIBLE_DOMAIN=
# PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/script.tagged-events.js
# Umami : identifiant du site (ex. Umami Cloud, offre gratuite)
PUBLIC_UMAMI_WEBSITE_ID=
# PUBLIC_UMAMI_SRC=https://cloud.umami.is/script.js
